{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "NeverReadContentOrSecrets",
      "Effect": "Deny",
      "Action": [
        "s3:GetObject*",
        "ssm:GetParameter*",
        "secretsmanager:GetSecretValue",
        "secretsmanager:BatchGetSecretValue"
      ],
      "Resource": "*"
    },
    {
      "Sid": "NeverTouchTheBackupChainIdentities",
      "Effect": "Deny",
      "Action": "iam:*",
      "Resource": [
        "arn:aws:iam::884686184019:role/tfc-*",
        "arn:aws:iam::884686184019:user/pfv-backup-uploader",
        "arn:aws:iam::884686184019:role/github-actions-backup-probe",
        "arn:aws:iam::884686184019:oidc-provider/*"
      ]
    },
    {
      "Sid": "NeverTouchTheBackupBucket",
      "Effect": "Deny",
      "Action": "s3:*",
      "Resource": [
        "arn:aws:s3:::tbd-mysql-backups-884686184019",
        "arn:aws:s3:::tbd-mysql-backups-884686184019/*"
      ]
    },
    {
      "Sid": "NeverUseOrManageKeys",
      "Effect": "Deny",
      "Action": [
        "kms:Decrypt",
        "kms:ReEncrypt*",
        "kms:GenerateDataKey*",
        "kms:CreateGrant",
        "kms:PutKeyPolicy",
        "kms:ScheduleKeyDeletion",
        "kms:DisableKey"
      ],
      "Resource": "*"
    },
    {
      "Sid": "NeverMintOtherCredentials",
      "Effect": "Deny",
      "Action": [
        "sts:AssumeRole",
        "sts:AssumeRoleWithWebIdentity",
        "sts:AssumeRoleWithSAML",
        "sts:GetFederationToken",
        "sts:GetSessionToken",
        "iam:PassRole"
      ],
      "Resource": "*"
    },
    {
      "Sid": "NeverReadNodeAccess",
      "Effect": "Deny",
      "Action": [
        "lightsail:GetInstanceAccessDetails",
        "lightsail:DownloadDefaultKeyPair",
        "lightsail:GetRelationalDatabaseMasterUserPassword"
      ],
      "Resource": "*"
    }
  ]
}
