#cloud-config
# Runs once, at the node's first boot (INFRA-22). The instance ignores later changes to
# user_data, so editing this file does not touch the running node.
package_update: true
packages:
  - unattended-upgrades

# 2 GB swap is the cushion for a ~2.8 GB steady, ~3.1 GB peak workload on 4 GB.
swap:
  filename: /swapfile
  size: 2147483648
  maxsize: 2147483648

write_files:
  # Security updates only (the Ubuntu default origins), no automatic reboot: a reboot
  # restarts the databases, so it stays a deliberate act.
  - path: /etc/apt/apt.conf.d/20auto-upgrades
    content: |
      APT::Periodic::Update-Package-Lists "1";
      APT::Periodic::Unattended-Upgrade "1";
  - path: /etc/rancher/k3s/config.yaml
    permissions: "0600"
    content: |
      write-kubeconfig-mode: "0600"
      secrets-encryption: true
      kubelet-arg:
        - "fail-swap-on=false"

runcmd:
  # The installer is fetched at the release tag, not from get.k3s.io, so both the script
  # and the binary it verifies are pinned.
  - curl -sfL -o /tmp/k3s-install.sh "https://raw.githubusercontent.com/k3s-io/k3s/${k3s_version}/install.sh"
  - INSTALL_K3S_VERSION="${k3s_version}" sh /tmp/k3s-install.sh
