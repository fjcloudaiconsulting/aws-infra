{
  "folderUid": "platform",
  "overwrite": true,
  "message": "INFRA-108",
  "dashboard": {
    "uid": "node-memory",
    "title": "Node memory",
    "time": {
      "from": "now-7d",
      "to": "now"
    },
    "refresh": "5m",
    "schemaVersion": 39,
    "tags": [
      "platform"
    ],
    "panels": [
      {
        "id": 1,
        "type": "timeseries",
        "title": "Node memory available (kubelet view)",
        "gridPos": {
          "x": 0,
          "y": 0,
          "w": 24,
          "h": 10
        },
        "datasource": {
          "type": "prometheus",
          "uid": "grafanacloud-prom"
        },
        "targets": [
          {
            "refId": "A",
            "datasource": {
              "type": "prometheus",
              "uid": "grafanacloud-prom"
            },
            "expr": "(max by (instance) (machine_memory_bytes{job=\"cadvisor\"}) - max by (instance) (container_memory_working_set_bytes{job=\"cadvisor\", id=\"/\"})) / max by (instance) (machine_memory_bytes{job=\"cadvisor\"})",
            "legendFormat": "{{instance}}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percentunit",
            "min": 0,
            "max": 1,
            "custom": {
              "thresholdsStyle": {
                "mode": "line+area"
              }
            },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "red",
                  "value": null
                },
                {
                  "color": "orange",
                  "value": 0.1
                },
                {
                  "color": "green",
                  "value": 0.2
                }
              ]
            }
          },
          "overrides": []
        }
      }
    ]
  }
}
