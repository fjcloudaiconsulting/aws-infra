// Metrics to Grafana Cloud (INFRA-85, design in docs/architecture.md, Telemetry). Every series leaves through one
// OTLP/HTTP exporter, so the stack's write-only token (metrics:write) is the only credential.
// Not collected yet: traces (the apps adopt OTLP in INFRA-105 and INFRA-106; the token then needs traces:write) and
// logs (no stdout tailing: tbd-prod logs carry query strings until INFRA-110, and the data namespace never).

// ---- Export --------------------------------------------------------------------------------------------------------

otelcol.auth.basic "grafana_cloud" {
	username = sys.env("GRAFANA_CLOUD_INSTANCE_ID")
	password = sys.env("GRAFANA_CLOUD_TOKEN")
}

otelcol.exporter.otlphttp "grafana_cloud" {
	client {
		endpoint = sys.env("GRAFANA_CLOUD_OTLP_ENDPOINT")
		auth     = otelcol.auth.basic.grafana_cloud.handler
	}
}

otelcol.processor.batch "default" {
	output {
		metrics = [otelcol.exporter.otlphttp.grafana_cloud.input]
	}
}

// ---- Apps: OTLP/HTTP on 4318 (alloy.observability.svc) ------------------------------------------------------------

otelcol.receiver.otlp "apps" {
	http {
		endpoint = "0.0.0.0:4318"
	}

	// Metrics only. Traces and logs sent here are refused until they are wired (see the top of this file).
	output {
		metrics = [otelcol.processor.attributes.scrub.input]
	}
}

// Backstop for the INFRA-84 allowlist: these attributes carry tokens, emails and client addresses (and explode
// cardinality), so they never leave the node even if an app sets them.
otelcol.processor.attributes "scrub" {
	action {
		pattern = "^url\\..*"
		action  = "delete"
	}

	action {
		pattern = "^http\\.request\\.header\\..*"
		action  = "delete"
	}

	action {
		key    = "client.address"
		action = "delete"
	}

	action {
		key    = "exception.message"
		action = "delete"
	}

	output {
		metrics = [otelcol.processor.batch.default.input]
	}
}

// ---- Node and k3s: scraped every 60s, converted to OTLP ------------------------------------------------------------

otelcol.receiver.prometheus "scraped" {
	output {
		metrics = [otelcol.processor.batch.default.input]
	}
}

// Node: the embedded node_exporter, reading the host's /proc, /sys and / (read-only mounts).
prometheus.exporter.unix "node" {
	procfs_path    = "/host/proc"
	sysfs_path     = "/host/sys"
	rootfs_path    = "/host/root"
	udev_data_path = "/host/root/run/udev/data"
	set_collectors = ["cpu", "diskstats", "filesystem", "loadavg", "meminfo", "pressure", "uname", "vmstat"]

	filesystem {
		fs_types_exclude     = "^(autofs|binfmt_misc|bpf|cgroup2?|configfs|debugfs|devpts|devtmpfs|fusectl|hugetlbfs|mqueue|nsfs|overlay|proc|pstore|securityfs|squashfs|sysfs|tmpfs|tracefs)$"
		mount_points_exclude = "^/(dev|proc|run|sys|var/lib/kubelet|var/lib/rancher/k3s/agent/containerd)($|/)"
	}

	disk {
		device_exclude = "^(loop|ram|dm-|sr)\\d+$"
	}
}

// The exporter labels its target job="integrations/unix", instance=<pod name>, which changes on every rollout.
discovery.relabel "node" {
	targets = prometheus.exporter.unix.node.targets

	rule {
		target_label = "job"
		replacement  = "node"
	}

	rule {
		target_label = "instance"
		replacement  = sys.env("NODE_NAME")
	}
}

prometheus.scrape "node" {
	targets         = discovery.relabel.node.output
	scrape_interval = "60s"
	forward_to      = [otelcol.receiver.prometheus.scraped.receiver]
}

// Kubelet and cAdvisor on this node's kubelet (10250), with the pod's token (RBAC: nodes/metrics only).
prometheus.scrape "kubelet" {
	targets = [{
		"__address__" = sys.env("HOST_IP") + ":10250",
		"instance"    = sys.env("NODE_NAME"),
	}]
	job_name          = "kubelet"
	scheme            = "https"
	bearer_token_file = "/var/run/secrets/kubernetes.io/serviceaccount/token"
	scrape_interval   = "60s"

	tls_config {
		ca_file = "/var/run/secrets/kubernetes.io/serviceaccount/ca.crt"
	}

	forward_to = [prometheus.relabel.kubelet.receiver]
}

prometheus.scrape "cadvisor" {
	targets = [{
		"__address__" = sys.env("HOST_IP") + ":10250",
		"instance"    = sys.env("NODE_NAME"),
	}]
	job_name          = "cadvisor"
	metrics_path      = "/metrics/cadvisor"
	scheme            = "https"
	bearer_token_file = "/var/run/secrets/kubernetes.io/serviceaccount/token"
	scrape_interval   = "60s"

	tls_config {
		ca_file = "/var/run/secrets/kubernetes.io/serviceaccount/ca.crt"
	}

	forward_to = [prometheus.relabel.cadvisor.receiver]
}

// The kubelet's own endpoint exposes thousands of series (API client and runtime histograms); keep the pod counts.
prometheus.relabel "kubelet" {
	rule {
		source_labels = ["__name__"]
		regex         = "up|kubelet_running_pods|kubelet_running_containers|kubelet_volume_stats_(capacity|available|used)_bytes"
		action        = "keep"
	}

	forward_to = [otelcol.receiver.prometheus.scraped.receiver]
}

// cAdvisor: per-container CPU, memory, throttling, OOM and pod network, plus the whole node ("/") and the k3s
// service (k3s and containerd). Other systemd slices, cgroup ids, image names and veth interfaces are dropped.
prometheus.relabel "cadvisor" {
	rule {
		source_labels = ["__name__"]
		regex         = "up|machine_memory_bytes|container_cpu_usage_seconds_total|container_cpu_cfs_(throttled_)?periods_total|container_memory_working_set_bytes|container_memory_rss|container_spec_memory_limit_bytes|container_oom_events_total|container_network_(receive|transmit)_bytes_total"
		action        = "keep"
	}

	// Series of a pod, the two cgroups that are not pods, and the two series with neither.
	rule {
		source_labels = ["__name__", "pod", "id"]
		regex         = "(up|machine_memory_bytes);;|[^;]+;[^;]+;.*|[^;]+;;(/|/system\\.slice/k3s\\.service)"
		action        = "keep"
	}

	// A pod's series are named by namespace, pod and container; the cgroup id only adds a uid.
	rule {
		source_labels = ["pod"]
		regex         = ".+"
		target_label  = "id"
		replacement   = ""
	}

	rule {
		source_labels = ["interface"]
		regex         = "veth.*|cni0|flannel.*"
		action        = "drop"
	}

	rule {
		regex  = "image|name"
		action = "labeldrop"
	}

	forward_to = [otelcol.receiver.prometheus.scraped.receiver]
}
